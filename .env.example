# Use demo for local workflow testing without any API call.
LLM_MODE=demo

# For deployment, set LLM_MODE=openai and add the key as a platform secret.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY_SECRET=KEY_OPENAI
OPENAI_MAX_OUTPUT_TOKENS=800
OPENAI_TIMEOUT_SECONDS=45
OPENAI_GENERATION_LEASE_SECONDS=120

# Local development storage.
RISK_APP_DATA_DIR=data
STORAGE_BACKEND=local

# For Streamlit deployment, set STORAGE_BACKEND=dropbox and supply these as
# root-level Streamlit secrets. Never commit their real values.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_ROOT_PATH=/choice_under_risk_assignment
DROPBOX_CSV_NAME=answers.csv
DROPBOX_SUBJECT_CSV_NAME=subjects.csv

